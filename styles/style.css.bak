/* Основни стилове за хедъра и тялото */

html {
    margin: 0;
    padding: 0;
}

/* Основни стилове за хедъра и тялото */
header {
    background-color: white;
}

body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: LightBlue;
   
	font-size:1.2vw;
}


.header-image {
    width: 100%;
    max-height: 300px;
    object-fit: contain;
}


main {
    padding: 80px;
}
/* Навигация */
nav {
    background-color: #333;
    color: white;
    padding: 10px;
}

.dropdown-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
}

.dropdown-menu > li {
    position: relative;
    padding: 5px;
}

.dropdown-menu > li > a {
    color: white;
    text-decoration: none;
    padding: 8px 15px;
    display: block;
    font-size: 16px;
    transition: background-color 0.3s ease, color 0.3s ease;
}

/* Стилове за ховър ефекти */
.dropdown-menu > li > a:hover {
    background-color: #555;
    color: #FFD700;
}

.submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: #444;
    list-style: none;
    padding: 0;
    margin: 0;
}

.submenu li {
    padding: 5px;
}

.submenu li a {
    color: white;
    text-decoration: none;
    padding: 8px 15px;
    display: block;
    font-size: 18px;
    transition: background-color 0.3s ease, color 0.3s ease;
}

.submenu li a:hover {
    background-color: #666;
    color: #FFD700;
}

.dropdown-menu > li:hover .submenu {
    display: block;
}

/* Медия заявка за мобилни устройства */
@media (max-width: 768px) {
    .dropdown-menu {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
    }

    .dropdown-menu > li {
        padding: 5px;
    }

    .dropdown-menu > li > a {
        padding: 6px 10px;
        font-size: 10px;
    }
}
